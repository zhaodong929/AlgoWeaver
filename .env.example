# Default: no API key required. The mock model is deterministic and intended for tests/demo.
ALGOWEAVER_LLM_MODE=mock

# For LiteLLM mode, use LiteLLM's provider/model naming, e.g.:
# openai/<model-name>
# deepseek/<model-name>
# dashscope/<model-name>
# ollama/<model-name>
# openai/<model-name> with a compatible API base URL
ALGOWEAVER_LLM_MODEL=
ALGOWEAVER_CODE_LLM_MODEL=
ALGOWEAVER_LLM_API_KEY=
ALGOWEAVER_LLM_API_BASE=
ALGOWEAVER_LLM_TEMPERATURE=0.0
ALGOWEAVER_LLM_TIMEOUT_SECONDS=60
ALGOWEAVER_MAX_INPUT_CHARS=40000

# Optional semantic retrieval providers. Mock keeps the default offline path.
ALGOWEAVER_EMBEDDING_MODE=mock
ALGOWEAVER_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
ALGOWEAVER_EMBEDDING_API_KEY=
ALGOWEAVER_EMBEDDING_API_BASE=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/api/v1
ALGOWEAVER_EMBEDDING_TIMEOUT_SECONDS=60

ALGOWEAVER_RERANKER_MODE=mock
ALGOWEAVER_RERANKER_MODEL=qwen3-rerank
ALGOWEAVER_RERANKER_API_KEY=
ALGOWEAVER_RERANKER_API_BASE=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/api/v1
ALGOWEAVER_RERANKER_TIMEOUT_SECONDS=60

# Qdrant vector store. Keep memory for offline tests; use local for a persistent
# Windows-compatible database or server with deploy/qdrant/docker-compose.yml.
ALGOWEAVER_QDRANT_MODE=memory
ALGOWEAVER_QDRANT_URL=http://127.0.0.1:6333
ALGOWEAVER_QDRANT_PATH=data/processed/qdrant
ALGOWEAVER_QDRANT_API_KEY=
ALGOWEAVER_QDRANT_COLLECTION_NAME=algo_weaver_chunks
ALGOWEAVER_QDRANT_TIMEOUT_SECONDS=10

# Production API boundary. Keep `none` for local offline demos only.
ALGOWEAVER_API_AUTH_MODE=none
ALGOWEAVER_API_KEY=
# Requests per client IP in the rolling window. Set to 0 to disable locally.
ALGOWEAVER_RATE_LIMIT_REQUESTS=120
ALGOWEAVER_RATE_LIMIT_WINDOW_SECONDS=60
